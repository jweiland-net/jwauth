{
	"name": "jweiland/jwauth",
	"type": "typo3-cms-extension",
	"description": "IP Address Authentication - Automatic frontend login based on the visitor's IP address",
	"license": "GPL-2.0-or-later",
	"keywords": ["typo3", "TYPO3 CMS", "auth", "login"],
	"homepage": "https://jweiland.net",
	"authors": [
		{
			"name": "Stefan Froemken",
			"email": "projects@jweiland.net",
			"role": "Lead Developer"
		}
	],
	"support": {
		"email": "projects@jweiland.net",
		"issues": "https://github.com/jweiland-net/jwauth/issues",
		"source": "https://github.com/jweiland-net/jwauth"
	},
	"require": {
		"typo3/cms-core": "^14.3"
	},
	"require-dev": {
		"ergebnis/composer-normalize": "^2.44",
		"ssch/typo3-rector": "^3.6",
		"typo3/cms-install": "^14.3",
		"typo3/coding-standards": "^0.8",
		"typo3/testing-framework": "^9.5.0"
	},
	"autoload": {
		"psr-4": {
			"JWeiland\\Jwauth\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"JWeiland\\Jwauth\\Tests\\": "Tests"
		}
	},
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": ".Build/bin",
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"Package": {
				"providesPackages": {}
			},
			"extension-key": "jwauth",
			"version": "6.0.0",
			"web-dir": ".Build/public"
		}
	}
}
